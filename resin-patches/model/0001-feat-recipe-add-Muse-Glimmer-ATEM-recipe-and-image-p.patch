+        assert_eq!(config.resize_shape(10, 10).unwrap(), (28, 28));
+        assert_eq!(config.resize_shape(1024, 1024).unwrap(), (1036, 1036));
+        assert_eq!(config.resize_shape(1000, 1000).unwrap(), (1008, 1008));
+    }
