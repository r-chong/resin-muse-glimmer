+//! Muse Glimmer still-image patches.
+// Geometry follows Transformers' MuseGlimmerImageProcessor at v5.19.0 (Apache-2.0).
+
+use serde::{Deserialize, Serialize};
+
+use super::{RgbImage, Tensor, resize_filter};
+use crate::Error;
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(default)]
+pub struct Config {
+    pub patch_size: usize,
+    pub temporal_patch_size: usize,
+    pub merge_size: usize,
+    pub max_image_tokens: usize,
+    pub do_resize: bool,
+    pub do_rescale: bool,
+    pub do_normalize: bool,
+    pub image_mean: [f32; 3],
+    pub image_std: [f32; 3],
+    pub resample: u32,
+}
+
+impl Default for Config {
+    fn default() -> Self {
+        Self {
+            patch_size: 14,
+            temporal_patch_size: 2,
+            merge_size: 2,
+            max_image_tokens: 4096,
+            do_resize: true,
+            do_rescale: true,
+            do_normalize: true,
+            image_mean: [0.5; 3],
+            image_std: [0.5; 3],
+            // PIL LANCZOS, matching the checkpoint processor_config.json.
+            resample: 1,
+        }
+    }
+}
+
+/// Packed still-image payload: `pixel_values` `[patches, temporal*3*patch*patch]` in
+/// raster patch order, `image_grid_thw` `[images, 3]`, and `<|patch|>` tokens per image.
+pub use super::qwen::Prepared;
+
+impl Config {
+    fn validate(&self) -> Result<usize, Error> {
+        if self.patch_size == 0
+            || self.temporal_patch_size == 0
+            || self.merge_size == 0
+            || self.max_image_tokens == 0
+        {
+            return Err(Error::new(
+                "Muse patch, temporal, merge sizes and token cap must be positive",
+            ));
+        }
+        if !self.do_rescale {
+            // Decoded pixels are already in [0, 1]; HF rescales from [0, 255].
+            return Err(Error::new("Muse image preprocessing requires do_rescale"));
+        }
+        if self.image_mean.iter().any(|x| !x.is_finite())
+            || self.image_std.iter().any(|x| !x.is_finite() || *x <= 0.0)
+        {
+            return Err(Error::new(
+                "Muse normalization must have finite means and positive standard deviations",
+            ));
+        }
+        Ok(self.patch_size * self.merge_size)
+    }
+
+    /// HF `smart_resize`: the integer grid of `patch * merge` cells whose aspect
+    /// ratio is closest to the input, under `max_image_tokens` cells.
+    pub fn resize_shape(&self, width: usize, height: usize) -> Result<(usize, usize), Error> {
+        let factor = self.validate()?;
+        if width == 0 || height == 0 {
+            return Err(Error::new("image dimensions must be positive"));
+        }
+        if !self.do_resize {
+            if !width.is_multiple_of(factor) || !height.is_multiple_of(factor) {
+                return Err(Error::new(
+                    "unresized Muse images must be divisible by patch_size * merge_size",
+                ));
+            }
+            return Ok((height, width));
+        }
+        let max = self.max_image_tokens as f64;
+        let mut ideal_h = height as f64 / factor as f64;
+        let mut ideal_w = width as f64 / factor as f64;
+        let ratio = ideal_w / ideal_h;
+        if ideal_h * ideal_w > max {
+            ideal_h = (max / ratio).sqrt();
+            ideal_w = ideal_h * ratio;
+        }
+        let target = height as f64 / width as f64;
+        // HF builds a Python set of the floor/ceil grids, filters it, and takes
+        // the first minimum in set iteration order. Reproduce that order.
+        let candidates = python_set_order(&[
+            (ideal_h.floor() as i64, ideal_w.floor() as i64),
+            (ideal_h.floor() as i64, ideal_w.ceil() as i64),
+            (ideal_h.ceil() as i64, ideal_w.floor() as i64),
+            (ideal_h.ceil() as i64, ideal_w.ceil() as i64),
+        ]);
+        let mut best: Option<((i64, i64), f64)> = None;
+        for (h, w) in candidates {
+            if h < 1 || w < 1 || (h * w) as f64 > max {
+                continue;
+            }
+            let error = (h as f64 / w as f64 - target).abs();
+            if best.is_none_or(|(_, e)| error < e) {
+                best = Some(((h, w), error));
+            }
+        }
+        let (grid_h, grid_w) = match best {
+            Some(((h, w), _)) => (h as usize, w as usize),
+            None => (
+                (ideal_h.round_ties_even() as usize).max(1),
+                (ideal_w.round_ties_even() as usize).max(1),
+            ),
+        };
+        Ok((grid_h * factor, grid_w * factor))
+    }
+
+    pub fn process(&self, images: &[RgbImage]) -> Result<Prepared, Error> {
+        self.validate()?;
+        let filter = resize_filter(self.resample)?;
+        let patch = self.patch_size;
+        let temporal = self.temporal_patch_size;
+        let merge = self.merge_size;
+        let patch_width = temporal * 3 * patch * patch;
+        let mut pixels = Vec::new();
+        let mut grids = Vec::with_capacity(images.len() * 3);
+        let mut token_counts = Vec::with_capacity(images.len());
+        let mut total = 0usize;
+        for image in images {
+            let (height, width) = self.resize_shape(image.width, image.height)?;
+            let resized;
+            let image = if (width, height) == (image.width, image.height) {
+                image
+            } else {
+                resized = image.resize(width, height, filter)?;
+                &resized
+            };
+            let (grid_h, grid_w) = (height / patch, width / patch);
+            let count = grid_h * grid_w;
+            total += count;
+            pixels
+                .try_reserve(count * patch_width)
+                .map_err(|_| Error::new("Muse pixel tensor is too large"))?;
+            let value = |y: usize, x: usize, c: usize| {
+                let v = image.data[(y * width + x) * 3 + c];
+                if self.do_normalize {
+                    (v - self.image_mean[c]) / self.image_std[c]
+                } else {
+                    v
+                }
+            };
+            // Raster patches, each laid out as time/channel/height/width; a
+            // still image repeats across the temporal slots.
+            for gy in 0..grid_h {
+                for gx in 0..grid_w {
+                    for _ in 0..temporal {
+                        for c in 0..3 {
+                            for y in 0..patch {
+                                for x in 0..patch {
+                                    pixels.push(value(gy * patch + y, gx * patch + x, c));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            grids.extend([1, grid_h as i64, grid_w as i64]);
+            token_counts.push(count / (merge * merge));
+        }
+        Ok(Prepared {
+            pixel_values: Tensor::new(vec![total, patch_width], pixels)?,
+            image_grid_thw: Tensor::new(vec![images.len(), 3], grids)?,
+            token_counts,
+        })
+    }
+}
+
+/// CPython 3.8+ hash of a tuple of two small integers.
+fn python_pair_hash((a, b): (i64, i64)) -> i64 {
+    const P1: u64 = 11400714785074694791;
+    const P2: u64 = 14029467366897019727;
+    const P5: u64 = 2870177450012600261;
+    let lane = |v: i64| (if v == -1 { -2 } else { v }) as u64;
+    let mut acc = P5;
+    for item in [a, b] {
+        acc = acc.wrapping_add(lane(item).wrapping_mul(P2));
+        acc = acc.rotate_left(31);
+        acc = acc.wrapping_mul(P1);
+    }
+    acc = acc.wrapping_add(2 ^ (P5 ^ 3527539));
+    if acc as i64 == -1 {
+        1546275796
+    } else {
+        acc as i64
+    }
+}
+
+/// Iteration order of a small CPython set built from these items (8 slots,
+/// no linear probes at that size, perturbed open addressing).
+fn python_set_order(items: &[(i64, i64)]) -> Vec<(i64, i64)> {
+    const MASK: usize = 7;
+    let mut table: [Option<(i64, i64)>; 8] = [None; 8];
+    for &item in items {
+        let hash = python_pair_hash(item);
+        let mut perturb = hash as u64;
+        let mut i = (hash as u64 as usize) & MASK;
+        loop {
+            match table[i] {
+                None => {
+                    table[i] = Some(item);
+                    break;
+                }
+                Some(existing) if existing == item => break,
+                Some(_) => {
+                    perturb >>= 5;
+                    i = (i
+                        .wrapping_mul(5)
+                        .wrapping_add(1)
+                        .wrapping_add(perturb as usize))
+                        & MASK;
+                }
+            }
+        }
+    }
+    table.into_iter().flatten().collect()
+}
