+        let config = Config::default();
+        for &(w, h, rh, rw) in SMART_RESIZE_CASES {
+            assert_eq!(config.resize_shape(w, h).unwrap(), (rh, rw), "{w}x{h}");
+        }
+    }
+
+    #[test]
+    fn patches_are_raster_time_channel_height_width() {
+        let config = Config {
+            do_normalize: false,
+            ..Config::default()
+        };
+        let (w, h) = (56, 28);
+        let data = (0..w * h * 3)
+            .map(|i| (i % 251) as f32 / 251.0)
+            .collect::<Vec<_>>();
+        let image = RgbImage::new(w, h, data.clone()).unwrap();
+        let prepared = config.process(&[image]).unwrap();
+        assert_eq!(prepared.pixel_values.shape, vec![8, 1176]);
+        assert_eq!(prepared.image_grid_thw.data, vec![1, 2, 4]);
+        assert_eq!(prepared.token_counts, vec![2]);
+        // Patch 5 is row 1, column 1; element (t=1, c=2, y=3, x=4).
+        let row = &prepared.pixel_values.data[5 * 1176..6 * 1176];
+        let offset = 588 + 2 * 196 + 3 * 14 + 4;
+        assert_eq!(row[offset], data[((14 + 3) * w + 14 + 4) * 3 + 2]);
+        assert_eq!(row[..588], row[588..]);
+    }
+}
